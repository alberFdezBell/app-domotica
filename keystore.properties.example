# Copia este fichero como "keystore.properties" y rellena con tus datos reales.
# El fichero keystore.properties esta en el .gitignore y NO se sube a Git.
#
# Coloca tu fichero .keystore fuera del repositorio o usa variables de entorno en CI/CD.

KEYSTORE_FILE=../ruta/a/tu/release.keystore
KEYSTORE_PASSWORD=tu_contraseña_aqui
KEY_ALIAS=domotica
KEY_PASSWORD=tu_contraseña_aqui
